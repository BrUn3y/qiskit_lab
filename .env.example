# Required only when using environment credentials instead of an SDK account.
# Obtain an API key at https://quantum.cloud.ibm.com/
QISKIT_IBM_TOKEN=your_ibm_quantum_api_key
# Supported alternative: QISKIT_IBM_RUNTIME_APIKEY

# Optional instance CRN; recommended to select the intended IBM Quantum instance.
QISKIT_IBM_INSTANCE=
# Supported alternative: QISKIT_IBM_RUNTIME_INSTANCE

# This example is not loaded automatically. Set variables in the tool process
# environment, or configure the persistent SDK account using the hidden prompt.
